# ─────────────────────────────────────────────────────────────────────────────
# GoDoor — environment template
#
# Copy to `.env.local` for local dev:   cp .env.example .env.local
# Never commit a real .env file. `.env*` is already git-ignored.
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle, so it must
# be a public/safe value. Everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ───────────────────────────────────────────────────────
# Project URL and the *anon* key are safe to expose; the service-role key
# bypasses Row Level Security and must stay server-only.
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin portal (required in production) ─────────────────────────────────────
# The portal lives at /<ADMIN_PATH_SECRET> — set it to a long unguessable
# string. ADMIN_SESSION_SECRET signs the admin session cookie; if it is unset
# the code falls back to SUPABASE_SERVICE_ROLE_KEY.
# Generate with:  openssl rand -base64 48
ADMIN_PATH_SECRET=
ADMIN_SESSION_SECRET=

# ── Maps (optional) ───────────────────────────────────────────────────────────
# Without a Mapbox token the app still runs, but road routing and address
# autocomplete fall back to straight lines / OSRM. Get one at mapbox.com.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Mobile money (optional — defaults to the "demo" provider) ─────────────────
# MOMO_PROVIDER: demo | flutterwave | pesapal
MOMO_PROVIDER=demo
FLUTTERWAVE_SECRET_KEY=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# Shared secret used to sign/verify provider webhooks (see src/lib/momo.ts).
GODOOR_WEBHOOK_SECRET=
# Merchant collection details shown to customers at checkout.
MOMO_COLLECTION_NUMBER=
MOMO_COLLECTION_NAME=GoDoor Business

# ── Morse / USDT wallet (optional) ────────────────────────────────────────────
MORSE_USERNAME=@Godoor
MORSE_REFERRAL_CODE=AsAp4f
MORSE_DOWNLOAD_URL=https://morsemoney.com/download
USDT_WALLET_ADDRESS=
USDT_TO_UGX_RATE=
