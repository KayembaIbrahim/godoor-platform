{
  "name": "godoor-platform",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2024-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "PREFERENCES",
      "id": "5a661d1cbc654e099426d4ce5185877c"
    }
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "godoor.site/*",
      "zone_id": "4a437a3d3bd702ed1e638b5da30bd2f0"
    },
    {
      "pattern": "www.godoor.site/*",
      "zone_id": "4a437a3d3bd702ed1e638b5da30bd2f0"
    }
  ]
}