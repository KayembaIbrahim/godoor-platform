{
  "name": "godoor-platform",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2024-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "PREFERENCES",
      "id": "eeffd51dd4c24c3c8da755dcf92e3639"
    }
  ],
  "observability": {
    "enabled": true
  }
}