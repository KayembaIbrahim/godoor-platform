{
  "name": "godoor-platform",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "PREFERENCES",
      "id": "eeffd51dd4c24c3c8da755dcf92e3639"
    }
  ],
  "observability": {
    "enabled": true
  }
}