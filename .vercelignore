# Pre-revert snapshot of the workspace (kept locally for rollback).
.backup
.vercel-prod-bundle

# Secrets — .env.local holds SUPABASE_SERVICE_ROLE_KEY, which bypasses Row
# Level Security. Vercel only consults .vercelignore (NOT .gitignore) once this
# file exists, so without these lines the service-role key would be uploaded as
# a static asset and served at /.env.local. Real values are set with
# `vercel env add`, which stores them in the project's encrypted env store.
.env*
!.env.example
scripts/rider-live.js
scripts/ridecheck.js
scripts/.test-token
*.test-token

